{
  "schema_version": "gos-eval-v2",
  "role": "holdout",
  "description": "独立真实评测集。禁止使用 eval profile，禁止将 ground truth、case id 或期望关键词写入 prompt、规则映射或索引。",
  "cases": [
    {
      "id": "holdout-001",
      "domain": "cpu",
      "scenario": "drilldown_required",
      "symptom": "订单接口的 p99 延迟突然升高，容器 load average 持续超过核数，单个 worker 占满一个核心，内存稳定。",
      "ground_truth": "异常计算任务造成工作进程 CPU 饱和",
      "expected_keywords": ["CPU", "进程", "饱和"],
      "expected_evidence_keywords": ["load", "worker", "CPU"],
      "expected_status": "succeeded",
      "require_refine": true
    },
    {
      "id": "holdout-002",
      "domain": "cpu",
      "scenario": "evidence_conflict",
      "symptom": "支付服务告警显示 CPU 偶发 90%，但同一时段 throttling 指标为零；线程 dump 显示大量锁竞争。",
      "ground_truth": "线程锁竞争而非 CPU 配额限制导致请求排队",
      "expected_keywords": ["锁竞争", "排队", "CPU"],
      "expected_evidence_keywords": ["throttling", "锁", "thread"],
      "expected_status": "succeeded"
    },
    {
      "id": "holdout-003",
      "domain": "memory",
      "scenario": "support_evidence",
      "symptom": "推荐服务 RSS 每小时稳定增长，Full GC 后堆占用仍不下降，最终被 OOMKilled。",
      "ground_truth": "长期存活对象累积引发应用内存泄漏",
      "expected_keywords": ["内存泄漏", "对象", "OOM"],
      "expected_evidence_keywords": ["RSS", "Full GC", "OOMKilled"],
      "expected_status": "succeeded"
    },
    {
      "id": "holdout-004",
      "domain": "memory",
      "scenario": "refute_evidence",
      "symptom": "节点 memory available 很低，但业务容器 working set 正常；page cache 在批量文件读取后快速增长且可回收。",
      "ground_truth": "可回收文件页缓存造成节点内存表象偏高",
      "expected_keywords": ["页缓存", "可回收", "内存"],
      "expected_evidence_keywords": ["page cache", "working set", "available"],
      "expected_status": "succeeded"
    },
    {
      "id": "holdout-005",
      "domain": "network",
      "scenario": "backtracking_required",
      "symptom": "最初怀疑数据库慢查询，但数据库本地查询正常；应用到数据库的跨可用区连接出现重传和 RTT 抖动。",
      "ground_truth": "跨可用区链路重传导致数据库调用延迟",
      "expected_keywords": ["跨可用区", "重传", "链路"],
      "expected_evidence_keywords": ["RTT", "重传", "本地查询正常"],
      "expected_status": "succeeded",
      "require_backtrack": true
    },
    {
      "id": "holdout-006",
      "domain": "network",
      "scenario": "drilldown_required",
      "symptom": "只有新建连接失败，已有长连接正常；客户端解析出的服务地址已过期，权威 DNS 返回新的地址。",
      "ground_truth": "客户端 DNS 缓存未刷新导致连接旧地址",
      "expected_keywords": ["DNS", "缓存", "旧地址"],
      "expected_evidence_keywords": ["DNS", "新建连接", "权威"],
      "expected_status": "succeeded",
      "require_refine": true
